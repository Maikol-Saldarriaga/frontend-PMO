# Copiar a scripts/deploy.env (gitignored) y ajustar. Sourced por scripts/deploy-vps.sh
# y scripts/rollback-vps.sh.
#
# Mismo VPS que usa web_ascend (compartido con otros sitios: branchitex.com,
# ascendcloud.online, pezia.cloud, playapez.com, gimnasio) — solo cambia el
# destino (/var/www/fodc).
REMOTE_USER=juandiego
REMOTE_HOST=10.0.0.1
REMOTE_PORT=22
SSH_KEY=/Users/alex/.ssh/id_ed25519

# Directorio que nginx sirve para fodcpmo.cloud (location / { root ...; } en
# /etc/nginx/sites-available/fodcpmo.cloud del VPS). Recibe el contenido de
# dist/project-pmo/browser/ tal cual, sin subcarpeta extra.
REMOTE_WEB_DIR=/var/www/fodc
